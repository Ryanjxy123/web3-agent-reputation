{
  "scope": "Retained real HTTP400 parser fixture; no new requests or chain evidence.",
  "schema": {
    "paths": {
      "/api/swap/quote": {
        "post": {
          "summary": "Get Topaz API split/mixed CL and v2 smart order router quote",
          "operationId": "postSwapQuote",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sellToken",
                    "buyToken",
                    "sellAmount"
                  ],
                  "properties": {
                    "sellToken": {
                      "type": "string",
                      "description": "Token address or symbol (e.g. 'WBNB')"
                    },
                    "buyToken": {
                      "type": "string",
                      "description": "Token address or symbol"
                    },
                    "sellAmount": {
                      "type": "string",
                      "description": "Amount in human units (e.g. '1.5'), or hex raw units"
                    },
                    "chainId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "enum": [
                            56,
                            4663,
                            8453,
                            1,
                            5042
                          ]
                        },
                        {
                          "type": "string"
                        }
                      ],
                      "default": 56,
                      "description": "Topaz chain: 56 (BNB Chain), 4663 (Robinhood Chain), 8453 (Base), 1 (Ethereum) or 5042 (Arc). Slugs (bnb, robinhood, base, ethereum, arc) are also accepted."
                    },
                    "slippageBps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 500,
                      "default": 100
                    },
                    "deadlineSeconds": {
                      "type": "integer",
                      "minimum": 30,
                      "maximum": 1800,
                      "default": 600
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Swap quote",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/AgentResponse"
                      },
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/QuoteData"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "400": {
              "description": "Invalid input",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "mapping": {
    "calls_pointer": "/transactions",
    "fields": {
      "token_in": "/data/sellToken",
      "token_out": "/data/buyToken",
      "amount_in": "/data/sellAmount",
      "recipient": "/data/payer",
      "minimum_out": "/data/minOut",
      "quoted_out": "/data/expectedOut",
      "slippage_bps": "/data/topazApiQuote/slippageBips",
      "fixed_block": "/data/topazApiQuote/blockNumber",
      "chain_id": "/chainId",
      "issued_at": "/timestamp"
    },
    "rejection_error_pointer": "/error",
    "stage_scope": "Map final build response only; quote does not contain /data/payer or /transactions."
  },
