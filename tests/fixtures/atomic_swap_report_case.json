  "declaration_schema": {
    "openapi": "3.0.3",
    "info": {
      "title": "Topaz Agent API",
      "version": "0.22.1",
      "description": "Agentic ve(3,3) DeFi execution and strategy API for Topaz Dex on BNB Chain, Robinhood Chain, Base, Ethereum and Arc. Every market, wallet and calldata endpoint takes a `chainId`; BNB Chain is the default. Non-custodial: builds wallet-ready calldata but never signs or broadcasts transactions.",
      "contact": {
        "name": "Topaz Dex",
        "url": "https://topazdex.com"
      }
    },
    "servers": [
      {
        "url": "https://agents.topazdex.com",
        "description": "Production"
      }
    ],
    "paths": {
      "/api/swap/quote": {
        "post": {
          "summary": "Get Topaz API split/mixed CL and v2 smart order router quote",
          "operationId": "postSwapQuote",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sellToken",
                    "buyToken",
                    "sellAmount"
                  ],
                  "properties": {
                    "sellToken": {
                      "type": "string",
                      "description": "Token address or symbol (e.g. 'WBNB')"
                    },
                    "buyToken": {
                      "type": "string",
                      "description": "Token address or symbol"
                    },
                    "sellAmount": {
                      "type": "string",
                      "description": "Amount in human units (e.g. '1.5'), or hex raw units"
                    },
                    "chainId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "enum": [
                            56,
                            4663,
                            8453,
                            1,
                            5042
                          ]
                        },
                        {
                          "type": "string"
                        }
                      ],
                      "default": 56,
                      "description": "Topaz chain: 56 (BNB Chain), 4663 (Robinhood Chain), 8453 (Base), 1 (Ethereum) or 5042 (Arc). Slugs (bnb, robinhood, base, ethereum, arc) are also accepted."
                    },
                    "slippageBps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 500,
                      "default": 100
                    },
                    "deadlineSeconds": {
                      "type": "integer",
                      "minimum": 30,
                      "maximum": 1800,
                      "default": 600
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Swap quote",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/AgentResponse"
                      },
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/QuoteData"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "400": {
              "description": "Invalid input",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/api/swap/build": {
        "post": {
          "summary": "Build all Permit2 approval, swap and cleanup calls",
          "description": "Builds against the selected chain's Universal Router and Permit2. ERC20 inputs require one atomic wallet/account batch from taker. No Permit2 signature. The wrapped native (WBNB/WETH) is an ERC20; the native symbol (BNB or ETH) selects native currency. Arc has no native leg — trade USDC as an ERC20. Never send only the swap call or sequential EOA transactions as an atomic batch.",
          "operationId": "postSwapBuild",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sellToken",
                    "buyToken",
                    "sellAmount",
                    "taker"
                  ],
                  "properties": {
                    "sellToken": {
                      "type": "string"
                    },
                    "buyToken": {
                      "type": "string"
                    },
                    "sellAmount": {
                      "type": "string"
                    },
                    "taker": {
                      "type": "string",
                      "description": "Input-owning account that executes ALL calls and receives output"
                    },
                    "slippageBps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 500,
                      "default": 100,
                      "description": "Slippage in basis points (100 = 1%)"
                    },
                    "chainId": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "enum": [
                            56,
                            4663,
                            8453,
                            1,
                            5042
                          ]
                        },
                        {
                          "type": "string"
                        }
                      ],
                      "default": 56,
                      "description": "Topaz chain: 56 (BNB Chain), 4663 (Robinhood Chain), 8453 (Base), 1 (Ethereum) or 5042 (Arc). Slugs (bnb, robinhood, base, ethereum, arc) are also accepted."
                    },
                    "deadlineSeconds": {
                      "type": "integer",
                      "minimum": 30,
                      "maximum": 1800,
                      "default": 600
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Complete ordered transactions array",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/AgentResponse"
                      },
                      {
                        "properties": {
                          "data": {
                            "$ref": "#/components/schemas/QuoteData"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "400": {
              "description": "Invalid input",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
