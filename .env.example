# Copy to .env and replace the database placeholders with your own configuration.
# The application does not load .env automatically. Use: uv run --env-file .env ...
# Never commit .env or the secret files below.
REPUTATION_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/YOUR_DATABASE

# Preferred LLM configuration: private runtime/platform-config/llm.json.
# See docs/runbooks/LLM_CONFIGURATION.md for the JSON template and provider switching.
# The default JSON path is read automatically when present; this override is optional.
# REPUTATION_LLM_CONFIG_FILE=runtime/platform-config/llm.json
# Optional environment overrides (replace every YOUR_* placeholder before enabling).
# REPUTATION_LLM_BASE_URL=https://YOUR_LLM_HOST/YOUR_API_PREFIX
# REPUTATION_LLM_API_KEY_FILE=runtime/secrets/llm-api-key.txt
# REPUTATION_LLM_MODEL=YOUR_MODEL_ID
# REPUTATION_LLM_API_STYLE=chat_completions

# Optional LLM-only network settings; unset/empty proxy enables automatic discovery.
# Priority: this override > legacy CLI --proxy > HTTPS_PROXY / ALL_PROXY > OS static proxy > direct.
# HTTP_PROXY is only for HTTP, never a fallback proxy for HTTPS LLM requests.
# REPUTATION_LLM_PROXY=direct
# Or use one URL (replace PROXY_HOST and PROXY_PORT): http://, https:// or socks5://.
# REPUTATION_LLM_PROXY=http://PROXY_HOST:PROXY_PORT
# NO_PROXY always matches the original destination host; PAC/WPAD and socks5h are unsupported.
# auto: only all-Fake-IP DNS answers (198.18.0.0/15) with a selected proxy may use fixed-IP Cloudflare HTTPS DNS.
# system: disable that DNS fallback. Both modes require every destination IP to be public.
# REPUTATION_LLM_DNS_MODE=auto

# Legacy DeepSeek key-file setting remains supported.
# File contents: one API key, not a URL. CLI --key-file takes precedence.
# REPUTATION_LLM_KEY_FILE=runtime/secrets/deepseek-api-key.txt

# Optional override for supported ZAN BSC/Base requests; not for public Gnosis RPC.
# secrets/zan-base-rpc.txt is detected automatically without an environment variable.
# File contents: your complete ZAN Base mainnet RPC URL, including project key.
# CLI --zan-key-url-file takes precedence.
# REPUTATION_ZAN_KEY_FILE=secrets/zan-base-rpc.txt
# Optional ZAN-only network overrides; otherwise standard env/OS proxy discovery.
# REPUTATION_ZAN_PROXY=direct
# REPUTATION_ZAN_DNS_MODE=auto

# Optional reviewed Position contract version for new evaluations; unset uses v1.
# Create and review the new file first. Keep all published configs/dependencies unchanged.
# REPUTATION_POSITION_REVIEW_CONFIG=configs/position-adapter-reviews-v2.json
