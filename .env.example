# Run scripts/init_local.py to generate a random local token. Never commit .env.
OPERATOR_TOKEN=
POSTGRES_PASSWORD=
# Set DATABASE_URL for Compose/CI; native Windows setup reads runtime/local-db.json.
DATABASE_URL=
PUBLIC_ACCESS_ENABLED=false
# Trusted RPC is supplied by operator runtime configuration, never by bundles.
LOCAL_RPC_URL=http://127.0.0.1:8545
# Override these when Windows reserves the default 9101/9102 range.
FIXTURE_PORT_A=9101
FIXTURE_PORT_D=9102
