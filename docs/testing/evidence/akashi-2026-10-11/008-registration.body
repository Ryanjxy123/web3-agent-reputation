{"type":"https://eips.ethereum.org/EIPS/eip-8004#registration-v1","name":"Akashi Notari","description":"Proof of existence for any file. Send the SHA-256 hash; it is written on-chain on Base and the block time becomes the proof. The file never leaves its owner. One anchor is paid with x402 in USDC on Base; lookups are free.","services":[{"name":"web","endpoint":"https://akashi-notari.com/"},{"name":"MCP","endpoint":"https://anchor.akashi-notari.com/mcp","version":"2025-11-25"},{"name":"OpenAPI","endpoint":"https://anchor.akashi-notari.com/openapi.json","version":"3.1.0"}],"x402Support":true,"active":true,"registrations":[{"agentId":98097,"agentRegistry":"eip155:8453:0x8004A169FB4a3325136EB29fA0ceB6D2e539a432"}],"supportedTrust":[]}