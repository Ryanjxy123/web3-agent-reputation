{"$defs":{"Reason":{"enum":["AUTH_REQUIRED","ACCESS_NOT_GRANTED","UNSUPPORTED_PROTOCOL","MAPPING_UNCONFIRMED","CAPABILITY_EXPLICITLY_UNSUPPORTED","CAPABILITY_NOT_DECLARED","AGENT_SERVICE_ERROR","AGENT_TASK_FAILED","EVIDENCE_INCONSISTENT","RULE_VERSION_MISMATCH","BINDING_UNVERIFIED","BINDING_EXPIRED","PLATFORM_RPC_ERROR","PLATFORM_NETWORK_ERROR","INSUFFICIENT_SAMPLES","INSUFFICIENT_COVERAGE","PENDING_FINALITY","RPC_RECEIPT_NOT_FOUND","TIMEOUT","SERVICE_TIMEOUT","SCHEMA_ERROR","SEMANTIC_MISMATCH","IDENTITY_CHANGED","CHAIN_INSTANCE_CHANGED","TX_WRONG_CHAIN","TX_WRONG_EXECUTOR","TX_WRONG_TARGET","TASK_ID_MISMATCH","RECORD_HASH_MISMATCH","LOG_EMITTER_MISMATCH","TX_REVERTED","ACCEPTED_TASK_DEADLINE_EXCEEDED","DISPATCH_UNCERTAIN","STALE_EVIDENCE","NOT_DECLARED_READ_ONLY","CANCELLED_BY_OPERATOR","CONTENT_HASH_MISMATCH","MISSING_EVIDENCE","ANCHOR_NOT_CONFIRMED","RATE_LIMIT_PLATFORM_EXCEEDED","RATE_LIMIT_UNATTRIBUTED"],"title":"Reason","type":"string"}},"additionalProperties":false,"properties":{"business_outcome":{"const":"UNKNOWN","default":"UNKNOWN","title":"Business Outcome","type":"string"},"business_reason":{"const":"INSUFFICIENT_SAMPLES","default":"INSUFFICIENT_SAMPLES","title":"Business Reason","type":"string"},"endpoint_outcome":{"enum":["PASS","FAIL","UNKNOWN"],"title":"Endpoint Outcome","type":"string"},"endpoint_reason":{"anyOf":[{"$ref":"#/$defs/Reason"},{"type":"null"}]},"executor_outcome":{"const":"UNKNOWN","default":"UNKNOWN","title":"Executor Outcome","type":"string"},"executor_reason":{"const":"BINDING_UNVERIFIED","default":"BINDING_UNVERIFIED","title":"Executor Reason","type":"string"},"identity_hash":{"anyOf":[{"pattern":"^0x[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Identity Hash"},"openapi_bytes_hash":{"anyOf":[{"pattern":"^0x[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"title":"Openapi Bytes Hash"},"protocol":{"enum":["akashi-http-readonly-v1","akashi-mcp-readonly-v1"],"title":"Protocol","type":"string"},"registration_o