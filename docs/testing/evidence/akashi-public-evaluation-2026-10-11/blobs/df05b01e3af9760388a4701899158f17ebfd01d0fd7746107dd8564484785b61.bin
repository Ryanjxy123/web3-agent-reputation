2.236","172.67.207.151","2606:4700:3035::ac43:cf97","2606:4700:3037::6815:16ec"],"sequence":9},"body_bytes":4394,"body_sha256":"e44f0159c066b23e3c13761b94626cfa2ede1b7adf71b5c6081c5e41f80a692f","content_type":"application/json","json":{"info":{"contact":{"name":"Akashi Notari","url":"https://github.com/self-reality/verifier/issues"},"description":"Proof of existence for any file. The SHA-256 hash is written on-chain on Base and the block time becomes the proof. The file never leaves its owner.","title":"Akashi Notari","version":"1.1.0","x-guidance":"Compute the SHA-256 of the file locally and POST /anchor with JSON { \"hash\": \"<64 hex chars>\", \"filename\": \"<optional>\" } to timestamp it on Base; pay with x402 (USDC on Base). The response holds txHash and certificateUrl, a page where a person can download a PDF certificate. Before paying, call GET /proof?hash=<64 hex chars> for free to see whether the hash is already anchored and when. Never send the file itself. An MCP server with the same two actions is at /mcp."},"openapi":"3.1.0","paths":{"/anchor":{"post":{"operationId":"anchor","requestBody":{"content":{"application/json":{"schema":{"properties":{"filename":{"description":"Optional name to record with the hash: a-z 0-9 - _ .","example":"report.pdf","maxLength":128,"type":"string"},"hash":{"description":"SHA-256 of the file, 64 hex characters","example":"be44340d151cbfa7a5dc59b579dd6632fb0891b573f8fdc927264309a3b168f0","pattern":"^(0x)?[0-9a-fA-F]{64}$","type":"string"}},"required":["hash"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"blockNumber":{"type":"integer"},"certificateUrl":{"description":"Page where a person can view and download the PDF certificate","type":["string","null"]},"chain":{"type":"string"},"chainId":{"type":"integer"},"contract":{"type":"string"},"currency":{"enum":["USDC","ETH"],"type":"string"},"explorerUrl":{"type":["string","null"]},"filename":{"type":"string"},"hash":{"type":"string"},"ok":{"type":"boolean"},"paid":{"description":"Fee in atomic units of `currency`","type":"string"},"submitter":{"description":"Address that paid for the anchor","type":"string"},"timestamp":{"description":"Block time, Unix seconds","type":"integer"},"timestampIso":{"type":"string"},"txHash":{"type":"string"}},"required":["hash","txHash","timestamp"],"type":"object"}}},"description":"Anchored. The proof, with the transaction hash and a certificate link"},"402":{"description":"Payment Required"}},"summary":"Anchor - write a SHA-256 file hash on-chain as a timestamped proof of existence","tags":["Notary"],"x-payment-info":{"price":{"amount":"0.010000","currency":"USD","mode":"fixed"},"protocols":[{"x402":{}}]}}},"/health":{"get":{"operationId":"health","responses":{"200":{"description":"OK"}},"security":[],"summary":"Health check"}},"/proof":{"get":{"operationId":"proof","parameters":[{"description":"SHA-256 of the file, 64 hex characters","in":"query","name":"hash","required":false,"schema":{"type":"string"}},{"description":"Transaction hash; use instead of hash","in":"query","name":"tx","required":false,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"anchored":{"type":"boolean"},"proofs":{"items":{"properties":{"blockNumber":{"type":"integer"},"certificateUrl":{"description":"Page where a person can view and download the PDF certificate","type":["string","null"]},"chain":{"type":"string"},"chainId":{"type":"integer"},"contract":{"type":"string"},"currency":{"enum":["USDC","ETH"],"type":"string"},"explorerUrl":{"type":["string","null"]},"filename":{"type":"string"},"hash":{"type":"string"},"paid":{"description":"Fee in atomic units of `currency`","type":"string"},"submitter":{"description":"Address that paid for the anchor","type":"string"},"timestamp":{"description":"Block time, Unix seconds","type":"integer"},"timestampIso":{"type":"string"},"txHash":{"type":"string"}},"required":["hash","txHash","timestamp"],"type":"object"},"type":"array"},"searched":{"description":"Contracts that were searched","items":{"type":"string"},"type":"array"},"unsearched":{"description":"Contracts that could not be searched this time; present only when the answer is partial","items":{"type":"string"},"type":"array"}},"required":["anchored","proofs"],"type":"object"}}},"description":"Whether the hash is anchored, and its proofs, earliest first"}},"security":[],"summary":"Proof - look up the proofs of a file hash, or the proof written by a transaction","tags":["Notary"]}}},"servers":[{"url":"https://anchor.akashi-notari.com"}]},"raw_body_retained":true,"raw_body_utf8":"{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Akashi Notari\",\"version\":\"1.1.0\",\"contact\":{\"name\":\"Akashi Notari\",\"url\":\"https://github.com/self-reality/verifier/issues\"},\"description\":\"Proof of existence for any file. The SHA-256 hash is written on-chain on Base and the block time becomes the proof. The file never leaves its owner.\",\"x-guidance\":\"Compute the SHA-256 of the file locally and POST /anchor with JSON { \\\"hash\\\": \\\"<64 hex chars>\\\", \\\"filename\\\": \\\"<optional>\\\" } to timestamp it on Base; pay with x402 (USDC on Base). The response holds txHash and certificateUrl, a page where a person can download a PDF certificate. Before paying, call GET /proof?hash=<64 hex chars> for free to see whether the hash is already anchored and when. Never send the file itself. An MCP server with the same two actions is at /mcp.\"},\"servers\":[{\"url\":\"https://anchor.akashi-notari.com\"}],\"paths\":{\"/anchor\":{\"post\":{\"operationId\":\"anchor\",\"summary\":\"Anchor - write a SHA-256 file hash on-chain as a timestamped proof of existence\",\"tags\":[\"Notary\"],\"x-payment-info\":{\"price\":{\"mode\":\"fixed\",\"currency\":\"USD\",\"amount\":\"0.010000\"},\"protocols\":[{\"x402\":{}}]},\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"