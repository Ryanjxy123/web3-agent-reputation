T07:40:17.609Z"},"record":{"blob_hash":"0x6dfd747b4912881ab9b388d33e960259e543a031fd848f846420d43f3bb190a9","byte_count":640,"collector_version":"platform-v1","evidence_id":"46924e65-c459-4951-b20d-dd7db5ce46d6","media_type":"application/json","observed_at":"2026-10-11T07:40:20.116Z","path":"blobs/6dfd747b4912881ab9b388d33e960259e543a031fd848f846420d43f3bb190a9.bin","redaction_profile":"credentials-v1","source":"public-readonly-response","trust_group":"public-http"}},{"body":{"capability_id":"verify_record","method":"POST","origin":"https://anchor.akashi-notari.com","path":"/mcp","protocol":"akashi-mcp-readonly-v1","request_json":{"id":2,"jsonrpc":"2.0","method":"tools/list","params":{}},"started_at":"2026-10-11T07:40:20.141Z"},"record":{"blob_hash":"0x3970c8901a712f362a0c4cf9f6036bddc1d7ab07bcabac6815b4dad39576490a","byte_count":257,"collector_version":"platform-v1","evidence_id":"d728b921-67ba-4a38-9ef4-f7e260b89b76","media_type":"application/json","observed_at":"2026-10-11T07:40:20.141Z","path":"blobs/3970c8901a712f362a0c4cf9f6036bddc1d7ab07bcabac6815b4dad39576490a.bin","redaction_profile":"credentials-v1","source":"public-readonly-intent","trust_group":"public-http"}},{"body":{"capability_id":"verify_record","method":"POST","origin":"https://anchor.akashi-notari.com","path":"/mcp","protocol":"akashi-mcp-readonly-v1","request_json":{"id":2,"jsonrpc":"2.0","method":"tools/list","params":{}},"response":{"audit":{"body_not_read":false,"payment_required":false,"resolved_ips":["104.21.22.236","172.67.207.151","2606:4700:3035::ac43:cf97","2606:4700:3037::6815:16ec"],"sequence":7},"body_bytes":1455,"body_sha256":"b86fb908caaeb9a888e03bfbbb50d484f542531398e60a1a62a5cc321d18520d","content_type":"application/json","json":{"id":2,"jsonrpc":"2.0","result":{"tools":[{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Free. Look up whether a file hash is anchored on Base and when, or read the proof written by a transaction. Pass `hash` or `tx`. Call it before anchor_hash to avoid paying for a hash that is already anchored.","inputSchema":{"properties":{"hash":{"description":"SHA-256 of the file, 64 hex characters","pattern":"^(0x)?[0-9a-fA-F]{64}$","type":"string"},"tx":{"description":"Transaction hash; use instead of hash","pattern":"^0x[0-9a-fA-F]{64}$","type":"string"}},"type":"object"},"name":"find_proof","title":"Find a proof of existence"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Paid with x402 (USDC on Base). Writes the SHA-256 hash of a file on-chain; the block time becomes the proof of existence. Compute the hash locally and never send the file. The hash, the filename and the payer address become public and permanent. Without a payment in _meta[\"x402/payment\"] the result is the payment requirement.","inputSchema":{"properties":{"filename":{"description":"Optional name to record with the hash: a-z 0-9 - _ .","maxLength":128,"type":"string"},"hash":{"description":"SHA-256 of the file, 64 hex characters","pattern":"^(0x)?[0-9a-fA-F]{64}$","type":"string"}},"required":["hash"],"type":"object"},"name":"anchor_hash","title":"Anchor a file hash"}]}},"raw_body_retained":true,"raw_body_utf8":"{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"find_proof\",\"title\":\"Find a proof of existence\",\"description\":\"Free. Look up whether a file hash is anchored on Base and when, or read the proof written by a transaction. Pass `hash` or `tx`. Call it before anchor_hash to avoid paying for a hash that is already anchored.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"hash\":{\"type\":\"string\",\"pattern\":\"^(0x)?[0-9a-fA-F]{64}$\",\"description\":\"SHA-256 of the file, 64 hex characters\"},\"tx\":{\"type\":\"string\",\"pattern\":\"^0x[0-9a-fA-F]{64}$\",\"description\":\"Transaction hash; use instead of hash\"}}},\"annotations\":{\"readOnlyHint\":true,\"openWorldHint\":true}},{\"name\":\"anchor_hash\",\"title\":\"Anchor a file hash\",\"description\":\"Paid with x402 (USDC on Base). Writes the SHA-256 hash of a file on-chain; the block time becomes the proof of existence. Compute the hash locally and never send the file. The hash, the filename and the payer address become public and permanent. Without a payment in _meta[\\\"x402/payment\\\"] the result is the payment requirement.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"hash\":{\"type\":\"string\",\"pattern\":\"^(0x)?[0-9a-fA-F]{64}$\",\"description\":\"SHA-256 of the file, 64 hex characters\"},\"filename\":{\"type\":\"string\",\"maxLength\":128,\"description\":\"Optional name to record with the hash: a-z 0-9 - _ .\"}},\"required\":[\"hash\"]},\"annotations\":{\"readOnlyHint\":false,\"destructiveHint\":false,\"idempotentHint\":false,\"openWorldHint\":true}}]}}","status":200},"started_at":"2026-10-11T07:40:20.141Z"},"record":{"blob_hash":"0x47247178afaa245752bdaf21f1b13f3f14137f4a3f379f2b5b5be76586d13f98","byte_count":3682,"collector_version":"platform-v1","evidence_id":"fc024097-8bd7-4fdb-a786-05f77021c6bf","media_type":"application/json","observed_at":"2026-10-11T07:40:22.774Z","path":"blobs/47247178afaa245752bdaf21f1b13f3f14137f4a3f379f2b5b5be76586d13f98.bin","redaction_profile":"credentials-v1","source":"public-readonly-response","trust_group":"public-http"}},{"body":{"capability_id":"verify_record","method":"POST","origin":"https://anchor.akashi-notari.com","path":"/mcp","protocol":"akashi-mcp-readonly-v1","request_json":{"id":3,"jsonrpc":"2.0","method":"tools/call","params":{"arguments":{"tx":"0xd01d3e019906321b7d410538aebb696dec806df1099756ec85ac7b2da91df7fc"},"name":"find_proof"}},"started_at":"2026-10-11T07:40:23.138Z"},"record":{"blob_hash":"0x35ebae4bfc7b71b30fa386644eb3d62fa030f5555d3f24e651331d52f81e5d0b","byte_count":364,"collector_version":"platform-v1","evidence_id":"630e9db2-b36c-4f29-9812-677819d83f63","media_type":"application/json","observed_at":"2026-10-11T07:40:23.138Z","path":"blobs/35ebae4