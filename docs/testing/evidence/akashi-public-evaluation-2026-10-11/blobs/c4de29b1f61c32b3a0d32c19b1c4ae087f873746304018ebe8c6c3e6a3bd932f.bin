{"$defs":{"CriticalRisk":{"additionalProperties":false,"properties":{"assertion_id":{"format":"uuid4","title":"Assertion Id","type":"string"},"evidence_refs":{"items":{"format":"uuid4","type":"string"},"minItems":1,"title":"Evidence Refs","type":"array"},"reason_code":{"$ref":"#/$defs/Reason"},"rule_id":{"maxLength":100,"minLength":1,"title":"Rule Id","type":"string"},"slot_id":{"format":"uuid4","title":"Slot Id","type":"string"}},"required":["slot_id","assertion_id","rule_id","reason_code","evidence_refs"],"title":"CriticalRisk","type":"object"},"Reason":{"enum":["AUTH_REQUIRED","ACCESS_NOT_GRANTED","UNSUPPORTED_PROTOCOL","MAPPING_UNCONFIRMED","CAPABILITY_EXPLICITLY_UNSUPPORTED","CAPABILITY_NOT_DECLARED","AGENT_SERVICE_ERROR","AGENT_TASK_FAILED","EVIDENCE_INCONSISTENT","RULE_VERSION_MISMATCH","BINDING_UNVERIFIED","BINDING_EXPIRED","PLATFORM_RPC_ERROR","PLATFORM_NETWORK_ERROR","INSUFFICIENT_SAMPLES","INSUFFICIENT_COVERAGE","PENDING_FINALITY","RPC_RECEIPT_NOT_FOUND","TIMEOUT","SERVICE_TIMEOUT","SCHEMA_ERROR","SEMANTIC_MISMATCH","IDENTITY_CHANGED","CHAIN_INSTANCE_CHANGED","TX_WRONG_CHAIN","TX_WRONG_EXECUTOR","TX_WRONG_TARGET","TASK_ID_MISMATCH","RECORD_HASH_MISMATCH","LOG_EMITTER_MISMATCH","TX_REVERTED","ACCEPTED_TASK_DEADLINE_EXCEEDED","DISPATCH_UNCERTAIN","STALE_EVIDENCE","NOT_DECLARED_READ_ONLY","CANCELLED_BY_OPERATOR","CONTENT_HASH_MISMATCH","MISSING_EVIDENCE","ANCHOR_NOT_CONFIRMED","RATE_LIMIT_PLATFORM_EXCEEDED","RATE_LIMIT_UNATTRIBUTED"],"title":"Reason","type":"string"}},"additionalProperties":false,"properties":{"conclusion":{"enum":["CONFIRMED_CRITICAL_CONFLICT","NO_CONFIRMED_CRITICAL_CONFLICT"],"title":"Conclusion","type":"string"},"critical_findings":{"default":[],"items":{"$ref":"#/$defs/CriticalRisk"},"title":"Critical Findings","type":"array"},"evidence_gap_slots":{"default":[],"items":{"format":"uuid4","type":"string"},"title":"Evidence Gap Slots","type":"array"},"ordinary_failure_slots":{"default":[],"items":{"format":"uuid4","type":"string"},"title":"Ordinary Failure Slots","type":"array"}},"required":["conclusion"],"title":"RiskAssessment","type":"object"}