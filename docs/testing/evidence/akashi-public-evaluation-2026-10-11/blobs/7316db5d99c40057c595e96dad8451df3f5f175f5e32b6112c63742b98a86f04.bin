{"$defs":{"BindingMessage":{"additionalProperties":false,"properties":{"agent_key_hash":{"pattern":"^0x[0-9a-f]{64}$","title":"Agent Key Hash","type":"string"},"deadline":{"maximum":9007199254740991,"minimum":0,"title":"Deadline","type":"integer"},"endpoint_hash":{"pattern":"^0x[0-9a-f]{64}$","title":"Endpoint Hash","type":"string"},"execution_chain_id":{"pattern":"^(0|[1-9][0-9]{0,77})$","title":"Execution Chain Id","type":"string"},"execution_chain_instance_hash":{"pattern":"^0x[0-9a-f]{64}$","title":"Execution Chain Instance Hash","type":"string"},"executor":{"title":"Executor","type":"string"},"issued_at":{"maximum":9007199254740991,"minimum":0,"title":"Issued At","type":"integer"},"nonce":{"pattern":"^0x[0-9a-f]{64}$","title":"Nonce","type":"string"},"snapshot_hash":{"pattern":"^0x[0-9a-f]{64}$","title":"Snapshot Hash","type":"string"}},"required":["agent_key_hash","snapshot_hash","executor","endpoint_hash","execution_chain_id","execution_chain_instance_hash","nonce","issued_at","deadline"],"title":"BindingMessage","type":"object"},"Reason":{"enum":["AUTH_REQUIRED","ACCESS_NOT_GRANTED","UNSUPPORTED_PROTOCOL","MAPPING_UNCONFIRMED","CAPABILITY_EXPLICITLY_UNSUPPORTED","CAPABILITY_NOT_DECLARED","AGENT_SERVICE_ERROR","AGENT_TASK_FAILED","EVIDENCE_INCONSISTENT","RULE_VERSION_MISMATCH","BINDING_UNVERIFIED","BINDING_EXPIRED","PLATFORM_RPC_ERROR","PLATFORM_NETWORK_ERROR","INSUFFICIENT_SAMPLES","INSUFFICIENT_COVERAGE","PENDING_FINALITY","RPC_RECEIPT_NOT_FOUND","TIMEOUT","SERVICE_TIMEOUT","SCHEMA_ERROR","SEMANTIC_MISMATCH","IDENTITY_CHANGED","CHAIN_INSTANCE_CHANGED","TX_WRONG_CHAIN","TX_WRONG_EXECUTOR","TX_WRONG_TARGET","TASK_ID_MISMATCH","RECORD_HASH_MISMATCH","LOG_EMITTER_MISMATCH","TX_REVERTED","ACCEPTED_TASK_DEADLINE_EXCEEDED","DISPATCH_UNCERTAIN","STALE_EVIDENCE","NOT_DECLARED_READ_ONLY","CANCELLED_BY_OPERATOR","CONTENT_HASH_MISMATCH","MISSING_EVIDENCE","ANCHOR_NOT_CONFIRMED","RATE_LIMIT_PLATFORM_EXCEEDED","RATE_LIMIT_UNATTRIBUTED"],"title":"Reason","type":"string"}}