{
  "$defs": {
    "PublicRegistrationMetadata": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "registration_agent_key": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Registration Agent Key",
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/PublicServiceDeclaration"
          },
          "maxItems": 20,
          "title": "Services",
          "type": "array"
        },
        "supported_trust": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Supported Trust",
          "type": "array"
        },
        "type": {
          "const": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1",
          "title": "Type",
          "type": "string"
        },
        "x402_support": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X402 Support"
        }
      },
      "required": [
        "type",
        "name",
        "services",
        "registration_agent_key",
        "supported_trust"
      ],
      "title": "PublicRegistrationMetadata",
      "type": "object"
    },
    "PublicServiceDeclaration": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "name": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name",
        "endpoint"
      ],
      "title": "PublicServiceDeclaration",
      "type": "object"
    },
    "Reason": {
      "enum": [
        "AUTH_REQUIRED",
        "ACCESS_NOT_GRANTED",
        "UNSUPPORTED_PROTOCOL",
        "MAPPING_UNCONFIRMED",
        "CAPABILITY_EXPLICITLY_UNSUPPORTED",
        "CAPABILITY_NOT_DECLARED",
        "AGENT_SERVICE_ERROR",
        "AGENT_TASK_FAILED",
        "EVIDENCE_INCONSISTENT",
        "RULE_VERSION_MISMATCH",
        "BINDING_UNVERIFIED",
        "BINDING_EXPIRED",
        "PLATFORM_RPC_ERROR",
        "PLATFORM_NETWORK_ERROR",
        "INSUFFICIENT_SAMPLES",
        "INSUFFICIENT_COVERAGE",
        "PENDING_FINALITY",
        "RPC_RECEIPT_NOT_FOUND",
        "TIMEOUT",
        "SERVICE_TIMEOUT",
        "SCHEMA_ERROR",
        "SEMANTIC_MISMATCH",
        "IDENTITY_CHANGED",
        "CHAIN_INSTANCE_CHANGED",
        "TX_WRONG_CHAIN",
        "TX_WRONG_EXECUTOR",
        "TX_WRONG_TARGET",
        "TASK_ID_MISMATCH",
        "RECORD_HASH_MISMATCH",
        "LOG_EMITTER_MISMATCH",
        "TX_REVERTED",
        "ACCEPTED_TASK_DEADLINE_EXCEEDED",
        "DISPATCH_UNCERTAIN",
        "STALE_EVIDENCE",
        "NOT_DECLARED_READ_ONLY",
        "CANCELLED_BY_OPERATOR",
        "CONTENT_HASH_MISMATCH",
        "MISSING_EVIDENCE",
        "ANCHOR_NOT_CONFIRMED",
        "RATE_LIMIT_PLATFORM_EXCEEDED",
        "RATE_LIMIT_UNATTRIBUTED"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abi_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Abi Sha256",
      "type": "string"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicRegistrationMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata_bytes_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Metadata Bytes Hash"
    },
    "metadata_outcome": {
      "enum": [
        "PASS",
        "UNKNOWN"
      ],
      "title": "Metadata Outcome",
      "type": "string"
    },
    "metadata_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "openapi_bytes_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Openapi Bytes Hash"
    },
    "registration_outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Registration Outcome",
      "type": "string"
    },
    "registration_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "registry_code_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Registry Code Hash"
    },
    "registry_standard": {
      "const": "erc8004-v1",
      "default": "erc8004-v1",
      "title": "Registry Standard",
      "type": "string"
    },
    "rpc_source": {
      "pattern": "^[a-zA-Z0-9._:-]{1,200}$",
      "title": "Rpc Source",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hashes": {
      "items": {
        "pattern": "^0x[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Source Hashes",
      "type": "array"
    }
  },
  "required": [
    "abi_sha256",
    "registry_code_hash",
    "rpc_source",
    "source_hashes",
    "metadata_bytes_hash",
    "metadata",
    "registration_outcome",
    "registration_reason",
    "metadata_outcome",
    "metadata_reason"
  ],
  "title": "PublicIdentityRead",
  "type": "object"
}
