{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Agent Id",
          "type": "string"
        },
        "chain_id": {
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "title": "Chain Id",
          "type": "string"
        },
        "namespace": {
          "const": "eip155",
          "default": "eip155",
          "title": "Namespace",
          "type": "string"
        },
        "registry_address": {
          "title": "Registry Address",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "registry_address",
        "agent_id"
      ],
      "title": "AgentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_ref": {
      "$ref": "#/$defs/AgentRef"
    },
    "id": {
      "format": "uuid4",
      "title": "Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "controlled",
        "public_registry",
        "replay"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "const": "UNVERIFIED",
      "default": "UNVERIFIED",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "agent_ref",
    "source_type"
  ],
  "title": "AgentView",
  "type": "object"
}
