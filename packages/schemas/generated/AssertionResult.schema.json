{
  "$defs": {
    "JsonValue": {},
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Reason": {
      "enum": [
        "AUTH_REQUIRED",
        "ACCESS_NOT_GRANTED",
        "UNSUPPORTED_PROTOCOL",
        "MAPPING_UNCONFIRMED",
        "CAPABILITY_EXPLICITLY_UNSUPPORTED",
        "CAPABILITY_NOT_DECLARED",
        "AGENT_SERVICE_ERROR",
        "AGENT_TASK_FAILED",
        "EVIDENCE_INCONSISTENT",
        "RULE_VERSION_MISMATCH",
        "BINDING_UNVERIFIED",
        "BINDING_EXPIRED",
        "PLATFORM_RPC_ERROR",
        "PLATFORM_NETWORK_ERROR",
        "INSUFFICIENT_SAMPLES",
        "INSUFFICIENT_COVERAGE",
        "PENDING_FINALITY",
        "RPC_RECEIPT_NOT_FOUND",
        "TIMEOUT",
        "SERVICE_TIMEOUT",
        "SCHEMA_ERROR",
        "SEMANTIC_MISMATCH",
        "IDENTITY_CHANGED",
        "CHAIN_INSTANCE_CHANGED",
        "TX_WRONG_CHAIN",
        "TX_WRONG_EXECUTOR",
        "TX_WRONG_TARGET",
        "TASK_ID_MISMATCH",
        "RECORD_HASH_MISMATCH",
        "LOG_EMITTER_MISMATCH",
        "TX_REVERTED",
        "ACCEPTED_TASK_DEADLINE_EXCEEDED",
        "DISPATCH_UNCERTAIN",
        "STALE_EVIDENCE",
        "NOT_DECLARED_READ_ONLY",
        "CANCELLED_BY_OPERATOR",
        "CONTENT_HASH_MISMATCH",
        "MISSING_EVIDENCE",
        "ANCHOR_NOT_CONFIRMED",
        "RATE_LIMIT_PLATFORM_EXCEEDED",
        "RATE_LIMIT_UNATTRIBUTED"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "format": "uuid4",
      "title": "Assertion Id",
      "type": "string"
    },
    "critical": {
      "title": "Critical",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "format": "uuid4",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expected": {
      "$ref": "#/$defs/JsonValue"
    },
    "observed": {
      "$ref": "#/$defs/JsonValue"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "title": "Rule Version",
      "type": "string"
    },
    "slot_id": {
      "format": "uuid4",
      "title": "Slot Id",
      "type": "string"
    }
  },
  "required": [
    "assertion_id",
    "slot_id",
    "rule_id",
    "rule_version",
    "outcome",
    "reason_code",
    "expected",
    "observed",
    "evidence_refs",
    "critical"
  ],
  "title": "AssertionResult",
  "type": "object"
}
