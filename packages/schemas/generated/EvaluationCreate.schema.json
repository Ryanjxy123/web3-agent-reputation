{
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "default": "anchor_record",
      "enum": [
        "get_tx_status",
        "verify_record",
        "anchor_record"
      ],
      "title": "Capability Id",
      "type": "string"
    },
    "grant_ids": {
      "items": {
        "format": "uuid4",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Grant Ids",
      "type": "array"
    },
    "policy_version": {
      "const": "policy-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "profile": {
      "enum": [
        "record-read-v1",
        "record-write-v1"
      ],
      "title": "Profile",
      "type": "string"
    },
    "query_tx_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Tx Hash"
    },
    "record_executor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Executor"
    },
    "record_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Hash"
    },
    "record_request_id": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Request Id"
    },
    "review_version": {
      "minimum": 1,
      "title": "Review Version",
      "type": "integer"
    },
    "snapshot_id": {
      "format": "uuid4",
      "title": "Snapshot Id",
      "type": "string"
    },
    "suite_id": {
      "enum": [
        "m1-smoke-v1",
        "capabilities-v1"
      ],
      "title": "Suite Id",
      "type": "string"
    },
    "target_contract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Contract"
    }
  },
  "required": [
    "snapshot_id",
    "review_version",
    "profile",
    "policy_version",
    "grant_ids",
    "suite_id"
  ],
  "title": "EvaluationCreate",
  "type": "object"
}
