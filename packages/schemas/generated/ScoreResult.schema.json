      "title": "Advice",
      "type": "string"
    },
    "critical_conflict": {
      "title": "Critical Conflict",
      "type": "boolean"
    },
    "dimensions": {
      "additionalProperties": {
        "$ref": "#/$defs/ScoreDimension"
      },
