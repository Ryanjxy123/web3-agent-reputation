          "type": "string"
        },
        "sufficiency_bp": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sufficiency Bp"
        }
      },
      "required": [
        "state",
        "score_bp",
        "observed_score_bp",
        "coverage_bp",
        "sample_bp",
