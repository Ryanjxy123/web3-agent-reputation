{
  "$defs": {
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Reason": {
      "enum": [
        "AUTH_REQUIRED",
        "ACCESS_NOT_GRANTED",
        "UNSUPPORTED_PROTOCOL",
        "MAPPING_UNCONFIRMED",
        "CAPABILITY_EXPLICITLY_UNSUPPORTED",
        "CAPABILITY_NOT_DECLARED",
        "AGENT_SERVICE_ERROR",
        "AGENT_TASK_FAILED",
        "EVIDENCE_INCONSISTENT",
        "RULE_VERSION_MISMATCH",
        "BINDING_UNVERIFIED",
        "BINDING_EXPIRED",
        "PLATFORM_RPC_ERROR",
        "PLATFORM_NETWORK_ERROR",
        "INSUFFICIENT_SAMPLES",
        "INSUFFICIENT_COVERAGE",
        "PENDING_FINALITY",
        "RPC_RECEIPT_NOT_FOUND",
        "TIMEOUT",
        "SERVICE_TIMEOUT",
        "SCHEMA_ERROR",
        "SEMANTIC_MISMATCH",
        "IDENTITY_CHANGED",
        "CHAIN_INSTANCE_CHANGED",
        "TX_WRONG_CHAIN",
        "TX_WRONG_EXECUTOR",
        "TX_WRONG_TARGET",
        "TASK_ID_MISMATCH",
        "RECORD_HASH_MISMATCH",
        "LOG_EMITTER_MISMATCH",
        "TX_REVERTED",
        "ACCEPTED_TASK_DEADLINE_EXCEEDED",
        "DISPATCH_UNCERTAIN",
        "STALE_EVIDENCE",
        "NOT_DECLARED_READ_ONLY",
        "CANCELLED_BY_OPERATOR",
        "CONTENT_HASH_MISMATCH",
        "MISSING_EVIDENCE",
        "ANCHOR_NOT_CONFIRMED",
        "RATE_LIMIT_PLATFORM_EXCEEDED",
        "RATE_LIMIT_UNATTRIBUTED"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "enum": [
        "get_tx_status",
        "verify_record",
        "anchor_record"
      ],
      "title": "Capability Id",
      "type": "string"
    },
    "input_evidence_id": {
      "format": "uuid4",
      "title": "Input Evidence Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_version": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "title": "Rule Version",
      "type": "string"
    },
    "slot_id": {
      "format": "uuid4",
      "title": "Slot Id",
      "type": "string"
    }
  },
  "required": [
    "slot_id",
    "capability_id",
    "outcome",
    "reason_code",
    "rule_version",
    "input_evidence_id"
  ],
  "title": "ReportTaskResult",
  "type": "object"
}
