{
  "$defs": {
    "AnchorStatus": {
      "enum": [
        "NOT_REQUESTED",
        "QUEUED",
        "SIGNED",
        "BROADCAST",
        "CONFIRMING",
        "CONFIRMED",
        "FAILED",
        "REORGED"
      ],
      "title": "AnchorStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "block_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Hash"
    },
    "block_number": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Number"
    },
    "chain_instance_id": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Chain Instance Id",
      "type": "string"
    },
    "confirmations": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Confirmations",
      "type": "integer"
    },
    "contract": {
      "title": "Contract",
      "type": "string"
    },
    "publisher": {
      "title": "Publisher",
      "type": "string"
    },
    "report_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sequence"
    },
    "status": {
      "$ref": "#/$defs/AnchorStatus"
    },
    "trusted_chain_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Trusted Chain Key",
      "type": "string"
    },
    "tx_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tx Hash"
    }
  },
  "required": [
    "report_hash",
    "status",
    "trusted_chain_key",
    "chain_instance_id",
    "contract",
    "publisher",
    "tx_hash",
    "sequence",
    "block_number",
    "block_hash",
    "confirmations"
  ],
  "title": "AnchorReceipt",
  "type": "object"
}
