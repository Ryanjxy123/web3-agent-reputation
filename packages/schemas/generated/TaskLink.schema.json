{
  "$defs": {
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "block_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Hash"
    },
    "block_number": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Block Number"
    },
    "candidate_tx_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Tx Hash"
    },
    "capability_id": {
      "default": "anchor_record",
      "enum": [
        "get_tx_status",
        "verify_record",
        "anchor_record"
      ],
      "title": "Capability Id",
      "type": "string"
    },
    "executor": {
      "title": "Executor",
      "type": "string"
    },
    "log_index": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Log Index"
    },
    "match_status": {
      "$ref": "#/$defs/Outcome"
    },
    "request_id": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Request Id",
      "type": "string"
    },
    "verified_tx_hash": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified Tx Hash"
    }
  },
  "required": [
    "request_id",
    "candidate_tx_hash",
    "verified_tx_hash",
    "executor",
    "block_number",
    "block_hash",
    "log_index",
    "match_status"
  ],
  "title": "TaskLink",
  "type": "object"
}
