{
  "$defs": {
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "format": "uuid4",
          "title": "Assertion Id",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "format": "uuid4",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected": {
          "$ref": "#/$defs/JsonValue"
        },
        "observed": {
          "$ref": "#/$defs/JsonValue"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "enum": [
            "1",
            "2"
          ],
          "title": "Rule Version",
          "type": "string"
        },
        "slot_id": {
          "format": "uuid4",
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "slot_id",
        "rule_id",
        "rule_version",
        "outcome",
        "reason_code",
        "expected",
        "observed",
        "evidence_refs",
        "critical"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "JsonValue": {},
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Reason": {
      "enum": [
        "AUTH_REQUIRED",
        "ACCESS_NOT_GRANTED",
        "UNSUPPORTED_PROTOCOL",
        "MAPPING_UNCONFIRMED",
        "CAPABILITY_EXPLICITLY_UNSUPPORTED",
        "CAPABILITY_NOT_DECLARED",
        "AGENT_SERVICE_ERROR",
        "AGENT_TASK_FAILED",
        "EVIDENCE_INCONSISTENT",
        "RULE_VERSION_MISMATCH",
        "BINDING_UNVERIFIED",
        "BINDING_EXPIRED",
        "PLATFORM_RPC_ERROR",
        "PLATFORM_NETWORK_ERROR",
        "INSUFFICIENT_SAMPLES",
        "INSUFFICIENT_COVERAGE",
        "PENDING_FINALITY",
        "RPC_RECEIPT_NOT_FOUND",
        "TIMEOUT",
        "SERVICE_TIMEOUT",
        "SCHEMA_ERROR",
        "SEMANTIC_MISMATCH",
        "IDENTITY_CHANGED",
        "CHAIN_INSTANCE_CHANGED",
        "TX_WRONG_CHAIN",
        "TX_WRONG_EXECUTOR",
        "TX_WRONG_TARGET",
        "TASK_ID_MISMATCH",
        "RECORD_HASH_MISMATCH",
        "LOG_EMITTER_MISMATCH",
        "TX_REVERTED",
        "ACCEPTED_TASK_DEADLINE_EXCEEDED",
        "DISPATCH_UNCERTAIN",
        "STALE_EVIDENCE",
        "NOT_DECLARED_READ_ONLY",
        "CANCELLED_BY_OPERATOR",
        "CONTENT_HASH_MISMATCH",
        "MISSING_EVIDENCE",
        "ANCHOR_NOT_CONFIRMED",
        "RATE_LIMIT_PLATFORM_EXCEEDED",
        "RATE_LIMIT_UNATTRIBUTED"
      ],
      "title": "Reason",
      "type": "string"
    },
    "TaskLink": {
      "additionalProperties": false,
      "properties": {
        "block_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Hash"
        },
        "block_number": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,77})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Number"
        },
        "candidate_tx_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Tx Hash"
        },
        "capability_id": {
          "default": "anchor_record",
          "enum": [
            "get_tx_status",
            "verify_record",
            "anchor_record"
          ],
          "title": "Capability Id",
          "type": "string"
        },
        "executor": {
          "title": "Executor",
          "type": "string"
        },
        "log_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Index"
        },
        "match_status": {
          "$ref": "#/$defs/Outcome"
        },
        "request_id": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "verified_tx_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified Tx Hash"
        }
      },
      "required": [
        "request_id",
        "candidate_tx_hash",
        "verified_tx_hash",
        "executor",
        "block_number",
        "block_hash",
        "log_index",
        "match_status"
      ],
      "title": "TaskLink",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "items": {
        "$ref": "#/$defs/AssertionResult"
      },
      "title": "Assertions",
      "type": "array"
    },
    "critical_conflict": {
      "title": "Critical Conflict",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_link": {
      "$ref": "#/$defs/TaskLink"
    }
  },
  "required": [
    "assertions",
    "task_link",
    "outcome",
    "reason_code",
    "critical_conflict"
  ],
  "title": "RecordVerificationResult",
  "type": "object"
}
