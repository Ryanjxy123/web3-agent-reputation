{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PredictionToolDescriptor": {
      "additionalProperties": false,
      "description": "Concrete tool declarations parsed from the retained provider metadata.",
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "output_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Type"
        },
        "result_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Type"
        },
        "required_output_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Output Fields",
          "type": "array"
        },
        "probability_fields": {
          "items": {
            "type": "string"
          },
          "title": "Probability Fields",
          "type": "array"
        }
      },
      "required": [
        "operation",
        "description",
        "required_output_fields",
        "probability_fields"
      ],
      "title": "PredictionToolDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_key": {
      "title": "Candidate Key",
      "type": "string"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/PredictionToolDescriptor"
      },
      "title": "Tools",
      "type": "array"
    },
    "chain_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chain Id"
    },
    "protocol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protocol"
    },
    "metadata_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Source Id"
    },
    "metadata_source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Source File"
    },
    "input_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Format"
    },
    "output_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Format"
    },
    "published_mech": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published Mech"
    },
    "service_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Id"
    },
    "history_shape": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Shape"
    },
    "history_source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Source File"
    },
    "history_tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Tool"
    },
    "history_context_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Context Type"
    },
    "history_market": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Market"
    },
    "history_prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Prompt"
    }
  },
  "required": [
    "candidate_key",
    "claim_ids",
    "tools"
  ],
  "title": "PredictionHistoryDescriptor",
  "type": "object"
}
