{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "liquidity_delta": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Liquidity Delta"
    },
    "amount0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Amount0"
    },
    "amount1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Amount1"
    },
    "block_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block Number"
    },
    "transaction_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transaction Index"
    }
  },
  "required": [
    "verdict",
    "reason"
  ],
  "title": "LiquidityVerification",
  "type": "object"
}
