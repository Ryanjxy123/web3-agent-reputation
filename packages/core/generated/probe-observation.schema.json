{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MeasurementPurpose": {
      "enum": [
        "availability",
        "functional",
        "behavioral",
        "background"
      ],
      "title": "MeasurementPurpose",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_key": {
      "title": "Request Key",
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/MeasurementPurpose"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "request_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Json"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Http Status"
    },
    "elapsed_ms": {
      "title": "Elapsed Ms",
      "type": "number"
    },
    "outcome": {
      "$ref": "#/$defs/Verdict"
    },
    "error_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Kind"
    },
    "response_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response File"
    },
    "response_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Response Sha256"
    },
    "body_complete": {
      "title": "Body Complete",
      "type": "boolean"
    }
  },
  "required": [
    "request_key",
    "purpose",
    "url",
    "method",
    "request_json",
    "observed_at",
    "http_status",
    "elapsed_ms",
    "outcome",
    "error_kind",
    "response_file",
    "response_sha256",
    "body_complete"
  ],
  "title": "ProbeObservation",
  "type": "object"
}
