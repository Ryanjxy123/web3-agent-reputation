{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "planned": {
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "title": "Not Applicable",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "required": [
        "value",
        "planned",
        "observed",
        "passed",
        "failed",
        "unknown",
        "not_applicable",
        "p95_ms"
      ],
      "title": "DimensionScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "default": "liquidity-history-v1",
      "enum": [
        "liquidity-history-v1",
        "prediction-history-v1",
        "prediction-history-v2",
        "service-contract-v1",
        "service-fulfillment-v1",
        "evm-swap-builder-v1",
        "evm-swap-builder-v2"
      ],
      "title": "Policy Version",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/DimensionScore"
    },
    "functional": {
      "$ref": "#/$defs/DimensionScore"
    },
    "behavioral": {
      "$ref": "#/$defs/DimensionScore"
    },
    "overall": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Overall"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "NOT_EVALUATED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "availability",
    "functional",
    "behavioral",
    "overall",
    "status"
  ],
  "title": "ScoringOutcome",
  "type": "object"
}
