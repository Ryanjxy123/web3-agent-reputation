{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "label",
        "verdict",
        "explanation"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ReportFinding"
      },
      "title": "Checks",
      "type": "array"
    },
    "market": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market"
    },
    "condition_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition Id"
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Id"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "question_data": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Data"
    },
    "template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Id"
    },
    "outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "final_outcome": {
      "anyOf": [
        {
          "enum": [
            "yes",
            "no"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Outcome"
    },
    "opening_timestamp": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opening Timestamp"
    },
    "finalized_timestamp": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalized Timestamp"
    },
    "checked_block": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked Block"
    },
    "payouts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Payouts",
      "type": "array"
    }
  },
  "required": [
    "verdict",
    "reason",
    "checks"
  ],
  "title": "MarketSettlementVerification",
  "type": "object"
}
