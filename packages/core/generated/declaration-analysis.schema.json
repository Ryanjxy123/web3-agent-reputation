{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BusinessClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "access": {
          "enum": [
            "free",
            "paid",
            "auth_required",
            "unknown"
          ],
          "title": "Access",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/ClaimCitation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "operation",
        "description",
        "inputs",
        "outputs",
        "constraints",
        "access",
        "citations"
      ],
      "title": "BusinessClaim",
      "type": "object"
    },
    "ClaimCitation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "ClaimCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "declaration-analysis-v1",
      "default": "declaration-analysis-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/BusinessClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "gaps"
  ],
  "title": "DeclarationAnalysis",
  "type": "object"
}
