{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "reference": {
      "title": "Reference",
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETE",
        "NEEDS_INFO",
        "UNSUPPORTED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "QUEUED",
        "COLLECTING",
        "VERIFYING",
        "REPORTING",
        "DONE"
      ],
      "title": "Stage",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "candidate_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Key"
    },
    "report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Report Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "reference",
    "status",
    "stage",
    "message",
    "candidate_key",
    "report_id",
    "created_at",
    "updated_at"
  ],
  "title": "EvaluationJob",
  "type": "object"
}
