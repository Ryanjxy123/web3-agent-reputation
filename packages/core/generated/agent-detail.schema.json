{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdmissionCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/CheckCode"
        },
        "status": {
          "$ref": "#/$defs/Verdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "code",
        "status",
        "explanation",
        "evidence"
      ],
      "title": "AdmissionCheck",
      "type": "object"
    },
    "AgentProfile": {
      "additionalProperties": false,
      "description": "Source-backed business context, separate from a report and its scores.",
      "properties": {
        "business_summary": {
          "title": "Business Summary",
          "type": "string"
        },
        "ecosystem": {
          "title": "Ecosystem",
          "type": "string"
        },
        "role": {
          "enum": [
            "asset-execution",
            "chain-query",
            "research-delivery",
            "unverified"
          ],
          "title": "Role",
          "type": "string"
        },
        "registration_chain_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registration Chain Id"
        },
        "execution_chain_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Execution Chain Ids",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "execution_accounts": {
          "items": {
            "type": "string"
          },
          "title": "Execution Accounts",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "verified",
            "declared",
            "unverified"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "business_summary",
        "ecosystem",
        "role",
        "registration_chain_id",
        "execution_chain_ids",
        "capabilities",
        "execution_accounts",
        "evidence_status",
        "sources",
        "boundary"
      ],
      "title": "AgentProfile",
      "type": "object"
    },
    "AgentSummary": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "registration_reference": {
          "title": "Registration Reference",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "report_count": {
          "title": "Report Count",
          "type": "integer"
        },
        "latest_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "complete_report_count": {
          "default": 0,
          "title": "Complete Report Count",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "name",
        "registration_reference",
        "description",
        "report_count",
        "latest_report"
      ],
      "title": "AgentSummary",
      "type": "object"
    },
    "CandidateRecord": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "registration_reference": {
          "title": "Registration Reference",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/AdmissionCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "next_actions": {
          "items": {
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "registration_reference",
        "source_urls",
        "checks",
        "next_actions"
      ],
      "title": "CandidateRecord",
      "type": "object"
    },
    "CheckCode": {
      "enum": [
        "registration",
        "functional_declaration",
        "service_interface",
        "independent_oracle",
        "execution_binding",
        "execution_history"
      ],
      "title": "CheckCode",
      "type": "string"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "planned": {
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "title": "Not Applicable",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "required": [
        "value",
        "planned",
        "observed",
        "passed",
        "failed",
        "unknown",
        "not_applicable",
        "p95_ms"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "ReportSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "candidate_key": {
          "title": "Candidate Key",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/ScoringOutcome"
        },
        "shared_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/SharedAssessmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "candidate_key",
        "generated_at",
        "scope",
        "scores"
      ],
      "title": "ReportSummary",
      "type": "object"
    },
    "ScoreInterval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ScoreInterval",
      "type": "object"
    },
    "ScoringOutcome": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "liquidity-history-v1",
          "enum": [
            "liquidity-history-v1",
            "prediction-history-v1",
            "prediction-history-v2",
            "service-contract-v1",
            "service-fulfillment-v1",
            "evm-swap-builder-v1",
            "evm-swap-builder-v2",
            "transaction-agent-evidence-v1"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DimensionScore"
        },
        "functional": {
          "$ref": "#/$defs/DimensionScore"
        },
        "behavioral": {
          "$ref": "#/$defs/DimensionScore"
        },
        "overall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "functional",
        "behavioral",
        "overall",
        "status"
      ],
      "title": "ScoringOutcome",
      "type": "object"
    },
    "SharedAssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "score_status": {
          "enum": [
            "AVAILABLE",
            "INSUFFICIENT"
          ],
          "title": "Score Status",
          "type": "string"
        },
        "selected_scope_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Selected Scope Coverage",
          "type": "string"
        },
        "declaration_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Declaration Coverage",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "functional": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "behavioral": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/SharedCapabilityResult"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/SharedCaseResult"
          },
          "title": "Cases",
          "type": "array"
        },
        "task_count": {
          "title": "Task Count",
          "type": "integer"
        },
        "observation_count": {
          "title": "Observation Count",
          "type": "integer"
        },
        "selected_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Selected Capabilities",
          "type": "array"
        },
        "unselected_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Unselected Capabilities",
          "type": "array"
        },
        "risk_status": {
          "enum": [
            "NORMAL",
            "MAJOR_VIOLATION"
          ],
          "title": "Risk Status",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        }
      },
      "required": [
        "overall",
        "score_status",
        "selected_scope_coverage",
        "declaration_coverage",
        "availability",
        "functional",
        "behavioral",
        "capabilities",
        "cases",
        "task_count",
        "observation_count",
        "selected_capabilities",
        "unselected_capabilities",
        "risk_status",
        "blocked_reasons"
      ],
      "title": "SharedAssessmentResult",
      "type": "object"
    },
    "SharedCapabilityResult": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "declaration_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Declaration Coverage",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "functional": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "behavioral": {
          "$ref": "#/$defs/SharedDimensionResult"
        }
      },
      "required": [
        "capability_id",
        "title",
        "selected",
        "declaration_coverage",
        "availability",
        "functional",
        "behavioral"
      ],
      "title": "SharedCapabilityResult",
      "type": "object"
    },
    "SharedCaseResult": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/SharedCounts"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "availability",
            "functional",
            "behavioral"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "declaration_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declaration Group Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "interval",
        "counts",
        "coverage",
        "blocked_reasons",
        "case_ids",
        "case_id",
        "capability_id",
        "dimension",
        "declaration_group_id",
        "title"
      ],
      "title": "SharedCaseResult",
      "type": "object"
    },
    "SharedCounts": {
      "additionalProperties": false,
      "properties": {
        "planned": {
          "default": 0,
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "default": 0,
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "default": 0,
          "title": "Not Applicable",
          "type": "integer"
        },
        "measurement_invalid": {
          "default": 0,
          "title": "Measurement Invalid",
          "type": "integer"
        },
        "not_run": {
          "default": 0,
          "title": "Not Run",
          "type": "integer"
        },
        "protected_exit": {
          "default": 0,
          "title": "Protected Exit",
          "type": "integer"
        }
      },
      "title": "SharedCounts",
      "type": "object"
    },
    "SharedDimensionResult": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/SharedCounts"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        }
      },
      "required": [
        "interval",
        "counts",
        "coverage",
        "blocked_reasons",
        "case_ids"
      ],
      "title": "SharedDimensionResult",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentSummary"
    },
    "reports": {
      "items": {
        "$ref": "#/$defs/ReportSummary"
      },
      "title": "Reports",
      "type": "array"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "reports",
    "candidate"
  ],
  "title": "AgentDetail",
  "type": "object"
}
