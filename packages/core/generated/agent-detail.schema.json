{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdmissionCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/CheckCode"
        },
        "status": {
          "$ref": "#/$defs/Verdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "code",
        "status",
        "explanation",
        "evidence"
      ],
      "title": "AdmissionCheck",
      "type": "object"
    },
    "AgentSummary": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "registration_reference": {
          "title": "Registration Reference",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "report_count": {
          "title": "Report Count",
          "type": "integer"
        },
        "latest_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "name",
        "registration_reference",
        "description",
        "report_count",
        "latest_report"
      ],
      "title": "AgentSummary",
      "type": "object"
    },
    "CandidateRecord": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "registration_reference": {
          "title": "Registration Reference",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/AdmissionCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "next_actions": {
          "items": {
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "registration_reference",
        "source_urls",
        "checks",
        "next_actions"
      ],
      "title": "CandidateRecord",
      "type": "object"
    },
    "CheckCode": {
      "enum": [
        "registration",
        "functional_declaration",
        "service_interface",
        "independent_oracle",
        "execution_binding",
        "execution_history"
      ],
      "title": "CheckCode",
      "type": "string"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "planned": {
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "title": "Not Applicable",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "required": [
        "value",
        "planned",
        "observed",
        "passed",
        "failed",
        "unknown",
        "not_applicable",
        "p95_ms"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "ReportSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "candidate_key": {
          "title": "Candidate Key",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/ScoringOutcome"
        }
      },
      "required": [
        "id",
        "candidate_key",
        "generated_at",
        "scope",
        "scores"
      ],
      "title": "ReportSummary",
      "type": "object"
    },
    "ScoringOutcome": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "liquidity-history-v1",
          "enum": [
            "liquidity-history-v1",
            "prediction-history-v1",
            "prediction-history-v2",
            "service-contract-v1",
            "service-fulfillment-v1"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DimensionScore"
        },
        "functional": {
          "$ref": "#/$defs/DimensionScore"
        },
        "behavioral": {
          "$ref": "#/$defs/DimensionScore"
        },
        "overall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "functional",
        "behavioral",
        "overall",
        "status"
      ],
      "title": "ScoringOutcome",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentSummary"
    },
    "reports": {
      "items": {
        "$ref": "#/$defs/ReportSummary"
      },
      "title": "Reports",
      "type": "array"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "reports",
    "candidate"
  ],
  "title": "AgentDetail",
  "type": "object"
}
