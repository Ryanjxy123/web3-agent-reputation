{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BinaryPrediction": {
      "additionalProperties": false,
      "properties": {
        "p_yes": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Yes",
          "type": "number"
        },
        "p_no": {
          "maximum": 1,
          "minimum": 0,
          "title": "P No",
          "type": "number"
        },
        "final_outcome": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Final Outcome",
          "type": "string"
        }
      },
      "required": [
        "p_yes",
        "p_no",
        "final_outcome"
      ],
      "title": "BinaryPrediction",
      "type": "object"
    },
    "CapabilityCoverage": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "tested_scope": {
          "title": "Tested Scope",
          "type": "string"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "title": "Sample Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "capability_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Type"
        },
        "checker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checker Id"
        },
        "checker_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checker Version"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "description",
        "protocol",
        "tested_scope",
        "sample_ids",
        "findings",
        "missing_evidence"
      ],
      "title": "CapabilityCoverage",
      "type": "object"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "planned": {
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "title": "Not Applicable",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "required": [
        "value",
        "planned",
        "observed",
        "passed",
        "failed",
        "unknown",
        "not_applicable",
        "p95_ms"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "MeasurementPurpose": {
      "enum": [
        "availability",
        "functional",
        "behavioral",
        "background"
      ],
      "title": "MeasurementPurpose",
      "type": "string"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "label",
        "verdict",
        "explanation"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "SampleExplanation": {
      "additionalProperties": false,
      "properties": {
        "sample": {
          "$ref": "#/$defs/ScoredSample"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "input_summary": {
          "title": "Input Summary",
          "type": "string"
        },
        "claimed_output": {
          "title": "Claimed Output",
          "type": "string"
        },
        "independent_result": {
          "title": "Independent Result",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "title": "Checks",
          "type": "array"
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        }
      },
      "required": [
        "sample",
        "title",
        "input_summary",
        "claimed_output",
        "independent_result",
        "checks"
      ],
      "title": "SampleExplanation",
      "type": "object"
    },
    "ScoreInterval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ScoreInterval",
      "type": "object"
    },
    "ScoredSample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "task_key": {
          "title": "Task Key",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/MeasurementPurpose"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Elapsed Ms"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/BinaryPrediction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "task_key",
        "purpose",
        "verdict",
        "elapsed_ms",
        "reason",
        "evidence"
      ],
      "title": "ScoredSample",
      "type": "object"
    },
    "ScoringOutcome": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "liquidity-history-v1",
          "enum": [
            "liquidity-history-v1",
            "prediction-history-v1",
            "prediction-history-v2",
            "service-contract-v1",
            "service-fulfillment-v1",
            "evm-swap-builder-v1",
            "evm-swap-builder-v2",
            "transaction-agent-evidence-v1"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DimensionScore"
        },
        "functional": {
          "$ref": "#/$defs/DimensionScore"
        },
        "behavioral": {
          "$ref": "#/$defs/DimensionScore"
        },
        "overall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "functional",
        "behavioral",
        "overall",
        "status"
      ],
      "title": "ScoringOutcome",
      "type": "object"
    },
    "SharedAssessment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "shared-task-assessment-v1",
          "default": "shared-task-assessment-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/SharedCapability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/SharedCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/SharedTask"
          },
          "title": "Tasks",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/SharedObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/SharedAssessmentResult",
          "readOnly": true
        }
      },
      "required": [
        "capabilities",
        "cases",
        "tasks",
        "observations",
        "result"
      ],
      "title": "SharedAssessment",
      "type": "object"
    },
    "SharedAssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "score_status": {
          "enum": [
            "AVAILABLE",
            "INSUFFICIENT"
          ],
          "title": "Score Status",
          "type": "string"
        },
        "selected_scope_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Selected Scope Coverage",
          "type": "string"
        },
        "declaration_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Declaration Coverage",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "functional": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "behavioral": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/SharedCapabilityResult"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/SharedCaseResult"
          },
          "title": "Cases",
          "type": "array"
        },
        "task_count": {
          "title": "Task Count",
          "type": "integer"
        },
        "observation_count": {
          "title": "Observation Count",
          "type": "integer"
        },
        "selected_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Selected Capabilities",
          "type": "array"
        },
        "unselected_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Unselected Capabilities",
          "type": "array"
        },
        "risk_status": {
          "enum": [
            "NORMAL",
            "MAJOR_VIOLATION"
          ],
          "title": "Risk Status",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        }
      },
      "required": [
        "overall",
        "score_status",
        "selected_scope_coverage",
        "declaration_coverage",
        "availability",
        "functional",
        "behavioral",
        "capabilities",
        "cases",
        "task_count",
        "observation_count",
        "selected_capabilities",
        "unselected_capabilities",
        "risk_status",
        "blocked_reasons"
      ],
      "title": "SharedAssessmentResult",
      "type": "object"
    },
    "SharedCapability": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "write_operation": {
          "title": "Write Operation",
          "type": "boolean"
        },
        "declaration_groups": {
          "items": {
            "$ref": "#/$defs/SharedDeclarationGroup"
          },
          "title": "Declaration Groups",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "title",
        "selected",
        "write_operation",
        "declaration_groups"
      ],
      "title": "SharedCapability",
      "type": "object"
    },
    "SharedCapabilityResult": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "declaration_coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Declaration Coverage",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "functional": {
          "$ref": "#/$defs/SharedDimensionResult"
        },
        "behavioral": {
          "$ref": "#/$defs/SharedDimensionResult"
        }
      },
      "required": [
        "capability_id",
        "title",
        "selected",
        "declaration_coverage",
        "availability",
        "functional",
        "behavioral"
      ],
      "title": "SharedCapabilityResult",
      "type": "object"
    },
    "SharedCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "availability",
            "functional",
            "behavioral"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "declaration_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declaration Group Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Criterion Ids",
          "type": "array"
        },
        "task_keys": {
          "items": {
            "type": "string"
          },
          "title": "Task Keys",
          "type": "array"
        },
        "normal_execution": {
          "title": "Normal Execution",
          "type": "boolean"
        },
        "required_decisive": {
          "title": "Required Decisive",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "capability_id",
        "dimension",
        "declaration_group_id",
        "title",
        "criterion_ids",
        "task_keys",
        "normal_execution",
        "required_decisive"
      ],
      "title": "SharedCase",
      "type": "object"
    },
    "SharedCaseResult": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/SharedCounts"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "availability",
            "functional",
            "behavioral"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "declaration_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declaration Group Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "interval",
        "counts",
        "coverage",
        "blocked_reasons",
        "case_ids",
        "case_id",
        "capability_id",
        "dimension",
        "declaration_group_id",
        "title"
      ],
      "title": "SharedCaseResult",
      "type": "object"
    },
    "SharedCounts": {
      "additionalProperties": false,
      "properties": {
        "planned": {
          "default": 0,
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "default": 0,
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "default": 0,
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "default": 0,
          "title": "Not Applicable",
          "type": "integer"
        },
        "measurement_invalid": {
          "default": 0,
          "title": "Measurement Invalid",
          "type": "integer"
        },
        "not_run": {
          "default": 0,
          "title": "Not Run",
          "type": "integer"
        },
        "protected_exit": {
          "default": 0,
          "title": "Protected Exit",
          "type": "integer"
        }
      },
      "title": "SharedCounts",
      "type": "object"
    },
    "SharedDeclarationGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "selection_reason": {
          "default": "",
          "title": "Selection Reason",
          "type": "string"
        },
        "source_references": {
          "items": {
            "type": "string"
          },
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "group_id",
        "title",
        "selected",
        "source_references"
      ],
      "title": "SharedDeclarationGroup",
      "type": "object"
    },
    "SharedDimensionResult": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/SharedCounts"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "blocked_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Reasons",
          "type": "array"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        }
      },
      "required": [
        "interval",
        "counts",
        "coverage",
        "blocked_reasons",
        "case_ids"
      ],
      "title": "SharedDimensionResult",
      "type": "object"
    },
    "SharedObservation": {
      "additionalProperties": false,
      "properties": {
        "task_key": {
          "title": "Task Key",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "availability",
            "functional",
            "behavioral"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "measurement_validity": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "title": "Measurement Validity",
          "type": "string"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number"
            },
