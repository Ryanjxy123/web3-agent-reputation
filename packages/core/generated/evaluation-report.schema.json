{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BinaryPrediction": {
      "additionalProperties": false,
      "properties": {
        "p_yes": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Yes",
          "type": "number"
        },
        "p_no": {
          "maximum": 1,
          "minimum": 0,
          "title": "P No",
          "type": "number"
        },
        "final_outcome": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Final Outcome",
          "type": "string"
        }
      },
      "required": [
        "p_yes",
        "p_no",
        "final_outcome"
      ],
      "title": "BinaryPrediction",
      "type": "object"
    },
    "CapabilityCoverage": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "tested_scope": {
          "title": "Tested Scope",
          "type": "string"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "title": "Sample Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "description",
        "protocol",
        "tested_scope",
        "sample_ids",
        "findings",
        "missing_evidence"
      ],
      "title": "CapabilityCoverage",
      "type": "object"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "planned": {
          "title": "Planned",
          "type": "integer"
        },
        "observed": {
          "title": "Observed",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "unknown": {
          "title": "Unknown",
          "type": "integer"
        },
        "not_applicable": {
          "title": "Not Applicable",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "required": [
        "value",
        "planned",
        "observed",
        "passed",
        "failed",
        "unknown",
        "not_applicable",
        "p95_ms"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "MeasurementPurpose": {
      "enum": [
        "availability",
        "functional",
        "behavioral",
        "background"
      ],
      "title": "MeasurementPurpose",
      "type": "string"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "label",
        "verdict",
        "explanation"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "SampleExplanation": {
      "additionalProperties": false,
      "properties": {
        "sample": {
          "$ref": "#/$defs/ScoredSample"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "input_summary": {
          "title": "Input Summary",
          "type": "string"
        },
        "claimed_output": {
          "title": "Claimed Output",
          "type": "string"
        },
        "independent_result": {
          "title": "Independent Result",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "title": "Checks",
          "type": "array"
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Id"
        }
      },
      "required": [
        "sample",
        "title",
        "input_summary",
        "claimed_output",
        "independent_result",
        "checks"
      ],
      "title": "SampleExplanation",
      "type": "object"
    },
    "ScoredSample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "task_key": {
          "title": "Task Key",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/MeasurementPurpose"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Elapsed Ms"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "prediction": {
          "anyOf": [
            {
              "$ref": "#/$defs/BinaryPrediction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "task_key",
        "purpose",
        "verdict",
        "elapsed_ms",
        "reason",
        "evidence"
      ],
      "title": "ScoredSample",
      "type": "object"
    },
    "ScoringOutcome": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "liquidity-history-v1",
          "enum": [
            "liquidity-history-v1",
            "prediction-history-v1",
            "service-contract-v1"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DimensionScore"
        },
        "functional": {
          "$ref": "#/$defs/DimensionScore"
        },
        "behavioral": {
          "$ref": "#/$defs/DimensionScore"
        },
        "overall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "functional",
        "behavioral",
        "overall",
        "status"
      ],
      "title": "ScoringOutcome",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evaluation-report-v1",
      "default": "evaluation-report-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "policy_version": {
      "default": "liquidity-history-v1",
      "enum": [
        "liquidity-history-v1",
        "prediction-history-v1",
        "service-contract-v1"
      ],
      "title": "Policy Version",
      "type": "string"
    },
    "candidate_key": {
      "title": "Candidate Key",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "registration_reference": {
      "title": "Registration Reference",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "scope_exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Scope Exclusions",
      "type": "array"
    },
    "evaluation_window": {
      "title": "Evaluation Window",
      "type": "string"
    },
    "approach": {
      "title": "Approach",
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/SampleExplanation"
      },
      "title": "Samples",
      "type": "array"
    },
    "source_references": {
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "capabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CapabilityCoverage"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "scores": {
      "$ref": "#/$defs/ScoringOutcome",
      "readOnly": true
    }
  },
  "required": [
    "candidate_key",
    "name",
    "registration_reference",
    "generated_at",
    "scope",
    "scope_exclusions",
    "evaluation_window",
    "approach",
    "samples",
    "source_references",
    "limitations",
    "scores"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
