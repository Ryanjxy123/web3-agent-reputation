      "get": {
        "summary": "Get Evidence",
        "operationId": "get_evidence_api_reports__report_id__evidence_get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
