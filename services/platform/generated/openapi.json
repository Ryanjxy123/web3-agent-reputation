              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentSummary"
                  },
                  "type": "array",
                  "title": "Response List Agents Api Agents Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/runtime": {
      "get": {
        "summary": "Runtime",
        "operationId": "runtime_api_runtime_get",
